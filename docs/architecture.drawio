        <mxCell id="antes_lane" value="ANTES — storage acoplado al computo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;verticalAlign=top;fontColor=#b91c1c;fontStyle=1;fontSize=14;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
