        <mxCell id="endpoint" value="VPC Gateway Endpoint&#10;com.amazonaws.us-east-1.s3&#10;(gratis, sin NAT)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e3a8a;" vertex="1" parent="1">
