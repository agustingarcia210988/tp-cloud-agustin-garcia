        <mxCell id="disco" value="Disco local (EBS)&#10;imagenes subidas&#10;&#10;&#9888; SPOF" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fecaca;strokeColor=#b91c1c;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="110" width="130" height="90" as="geometry" />
