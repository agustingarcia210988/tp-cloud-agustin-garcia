        <mxCell id="s3" value="S3 · pixelhub-images&#10;versionado + lifecycle&#10;(uploads/* -&gt; Glacier a 90d)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#065f46;" vertex="1" parent="1">
