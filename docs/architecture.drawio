        <mxCell id="e_antes_2" value="lee / escribe archivos" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;" edge="1" parent="1" source="app01_antes" target="disco">
          <mxGeometry relative="1" as="geometry" />
