        <!-- ===================== DESPUES ===================== -->
        <mxCell id="despues_lane" value="DESPUES — storage desacoplado (S3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#065f46;verticalAlign=top;fontColor=#065f46;fontStyle=1;fontSize=14;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
