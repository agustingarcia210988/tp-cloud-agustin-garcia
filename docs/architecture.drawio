        <mxCell id="vpc_box" value="VPC pixelhub-vpc (10.42.0.0/16)&#10;subred pixelhub-subnet-app" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1e3a8a;fontColor=#1e3a8a;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="390" width="520" height="240" as="geometry" />
