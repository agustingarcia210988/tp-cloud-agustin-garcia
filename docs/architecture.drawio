        <mxCell id="role" value="IAM Role&#10;pixelhub-app-role&#10;(instance profile)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#92400e;size=14;" vertex="1" parent="1">
